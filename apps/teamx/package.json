{
	"name": "teamx",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Agent teams on pi with team-scoped capabilities, tasks and conversations",
	"bin": {
		"teamx": "launch.mjs"
	},
	"dependencies": {
		"@earendil-works/pi-coding-agent": "1.2.0",
		"typebox": "1.3.27"
	},
	"scripts": {
		"start": "node launch.mjs",
		"check": "node ../../node_modules/@biomejs/biome/bin/biome check --error-on-warnings . && tsc -p tsconfig.json --noEmit",
		"test:unit": "node --import ../../packages/coding-agent/src/experimental/source-resolver.ts --test test/*.test.ts"
	},
	"engines": {
		"node": ">=24.0.0"
	}
}
